{
  "name": "@dortort/artifact-callbacks-dev",
  "private": true,
  "version": "0.1.1",
  "description": "Dev scripts for the Artifact Callbacks mod (the plugin itself ships no node_modules)",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:conformance && npm run test:browser && npm run test:docs",
    "typecheck": "npm run typecheck:node && npm run typecheck:hooks",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:hooks": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --test \"test/unit/*.spec.ts\"",
    "test:conformance": "node --test \"test/conformance/*.spec.ts\"",
    "test:browser": "node --test \"test/browser/*.spec.ts\"",
    "test:docs": "node --test \"test/docs/*.spec.ts\"",
    "test:e2e": "node --test \"test/e2e/*.spec.ts\"",
    "test:hooks": "claude plugin test .",
    "validate": "claude plugin validate ."
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
