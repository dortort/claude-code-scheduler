{
  "name": "@dortort/artifact-callbacks-dev",
  "private": true,
  "version": "0.1.0",
  "description": "Dev scripts for the Artifact Callbacks mod (the plugin itself ships no node_modules)",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:conformance && npm run test:browser && npm run test:docs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:conformance": "node --test \"test/conformance/*.test.ts\"",
    "test:browser": "node --test \"test/browser/*.test.ts\"",
    "test:docs": "node --test \"test/docs/*.test.{ts,mjs}\"",
    "test:hooks": "claude plugin test .",
    "validate": "claude plugin validate ."
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
