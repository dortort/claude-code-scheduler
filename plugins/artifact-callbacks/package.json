{
  "name": "@dortort/artifact-callbacks-dev",
  "private": true,
  "version": "0.1.0",
  "description": "Dev scripts for the Artifact Callbacks mod (the plugin itself ships no node_modules)",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:conformance && npm run test:browser",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:conformance": "node --test --test-concurrency=1 test/conformance/*.test.mjs",
    "test:conformance:python": "CB_LISTENER_CMD=\"python3 sidecar/listener.py\" node --test --test-concurrency=1 test/conformance/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 test/browser/*.test.mjs"
  },
  "license": "MIT"
}
